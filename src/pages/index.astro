---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="grid gap-8 md:grid-cols-[1fr_12rem] md:items-start">
    <div class="max-w-2xl">
      <h1 class="mb-8 text-4xl font-semibold tracking-tight">About</h1>
      <div class="space-y-5 text-lg leading-8 text-base-content/85">
        <p>
          I am a biomedical engineer with a bachelor's and master's degree from
          <a
            class="font-medium underline underline-offset-4 decoration-base-content/50 hover:decoration-base-content"
            href="https://ethz.ch"
            target="_blank"
            rel="noreferrer"
          >ETH Zurich</a>,
          affiliated with the
          <a
            class="font-medium underline underline-offset-4 decoration-base-content/50 hover:decoration-base-content"
            href="https://orthobiomech.ethz.ch"
            target="_blank"
            rel="noreferrer"
          >Orthopaedic Biomechanics Lab</a>.
        </p>
        <p>
          My work focuses on biomechanics, clinical research, sports science,
          and machine learning applied to these fields, with a strong interest
          in teaching.
        </p>
        <p>
          My recent work has been as a lab engineer in a research lab, focused
          on technical and applied work at the intersection of engineering and
          research.
        </p>
        <p>
          This site is a home for my research and teaching.
        </p>
      </div>

      <div class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm">
        <a class="link link-hover" href="https://github.com/jeroeng44" target="_blank" rel="noreferrer">GitHub</a>
        <a class="link link-hover" href="https://www.linkedin.com/in/jeroen-g-7814a9278/" target="_blank" rel="noreferrer">LinkedIn</a>
        <a class="link link-hover" href="mailto:jeroengrigioni@icloud.com">Email</a>
        <a class="link link-hover" href="/JeroenGrigioniCV.pdf" target="_blank" rel="noreferrer">CV</a>
      </div>
    </div>

    <img
      src="/profile.png"
      alt="Portrait"
      class="w-full max-w-[12rem] rounded-sm border border-base-300 object-cover"
    />
  </section>
</BaseLayout>
