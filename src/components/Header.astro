---
const { title, activeItem } = Astro.props;

const navItems = [
  { href: "/research", id: "research", label: "Research" },
  { href: "/teaching", id: "teaching", label: "Teaching" },
];
---

<header class="border-b border-base-300">
  <div class="mx-auto flex max-w-4xl flex-col gap-4 px-6 py-6 sm:flex-row sm:items-center sm:justify-between">
    <a class="text-xl font-semibold tracking-tight" href="/">{title}</a>
    <nav aria-label="Primary">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  "transition-colors hover:text-base-content",
                  activeItem === item.id ? "text-base-content" : "text-base-content/70",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
