---
const { title, img, desc, url, badge, tags, target = "_blank" } = Astro.props;
import { Image } from "astro:assets";
---

<div class="rounded-lg bg-base-100 transition">
  <a href={url} target={target}>
    <div class="hero-content flex-col items-start gap-5 px-0 md:flex-row">
      {
        img && (
          <Image
            src={img}
            width={750}
            height={422}
            format="webp"
            alt={title}
            class="max-w-full md:max-w-[13rem] rounded-lg"
          />
        )
      }
      <div class="grow w-full">
        <h1 class="text-xl font-bold">
          {title}
          {badge && <div class="badge badge-secondary mx-2">{badge}</div>}
        </h1>
        <p class="py-1 text-1xl text-base-content/80">{desc}</p>
        <div class="card-actions justify-start">
          {
            tags &&
              tags.map((tag) => <span class="badge badge-outline">{tag}</span>)
          }
        </div>
      </div>
    </div>
  </a>
</div>
